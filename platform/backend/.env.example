# Copy to .env and fill in for local dev / deployment.
# Nothing here is a real secret — these are the placeholder defaults
# already baked into app/config.py.

DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_MINUTES=60

TRIAL_DAYS=7

FRONTEND_URL=http://localhost:3000

# Stripe — leave as placeholders to run in mock mode (no real Stripe
# account needed). Set real values + STRIPE_MOCK_MODE=false to go live.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_STANDARD=price_standard_placeholder
STRIPE_PRICE_ID_PRO=price_pro_placeholder
STRIPE_MOCK_MODE=true

SALES_EMAIL=sale@example-domain.com

SIGHTINGS_SOURCE_PATH=../netalertx-attck-bridge/output/sightings.stix.json
